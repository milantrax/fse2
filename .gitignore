# Dependencies
node_modules/
vendor/

# composer.lock is committed deliberately. This theme is a deployable artifact,
# not a library: without the lock, `composer install` resolves latest versions on
# every clone, so phpcs/WPCS drift between machines and lint results stop matching.

# Build outputs (uncomment for production)
# assets/build/
# blocks/*/build/

# OS files
.DS_Store
Thumbs.db

# IDE/Editor
.idea/
.vscode/
.claude/
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# Environment
.env
.env.local
blocks/*/build
assets/build

# Global styles backups
backups/theme.json.backup.*
backups
*.md
!readme.md

# Generated translation catalogues (regenerate with wp i18n make-pot)
languages/*.mo
