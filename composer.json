{
    "name": "fse2",
    "description": "A modern WordPress Full-Site Editing theme with custom blocks",
    "type": "wordpress-theme",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Milan Trajkovic",
            "email": "milantrax@gmail.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "wordpress/wp-ai-client": "^0.2.1"
    },
    "autoload": {
        "psr-4": {
            "FSE2\\": "inc/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
