{
    "core/button": {
        "elements": {
            "button": {
                ":focus": {
                    "color": {
                        "background": "var(--wp--preset--color--black)",
                        "text": "var(--wp--preset--color--white)"
                    }
                },
                ":hover": {
                    "color": {
                        "background": "var(--wp--preset--color--black)",
                        "text": "var(--wp--preset--color--white)"
                    }
                },
                "border": {
                    "radius": "var(--wp--custom--radius--pill)"
                },
                "color": {
                    "background": "var(--wp--preset--color--lemon)",
                    "text": "var(--wp--preset--color--blueberry)"
                },
                "css": "transition: all 0.3s ease-in-out;",
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--manrope)",
                    "fontSize": "var(--wp--preset--font-size--button)",
                    "fontWeight": "400",
                    "lineHeight": "1"
                }
            }
        }
    },
    "core/group": {
        "spacing": {
            "padding": {
                "bottom": "var(--wp--custom--space--blockY)",
                "top": "var(--wp--custom--space--blockY)"
            }
        }
    },
    "core/search": {
        "elements": {
            "button": {
                "border": {
                    "radius": "var(--wp--custom--radius--pill)"
                }
            }
        }
    }
}
