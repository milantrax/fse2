{
  "apiVersion": 3,
  "name": "my-theme/cards",
  "title": "Cards Container",
  "category": "design",
  "icon": "grid-view",
  "description": "A container for displaying multiple cards in a grid layout with heading and description",
  "textdomain": "my-fse-theme",
  "editorScript": "file:./build/index.js",
  "editorStyle": "file:./build/index.css",
  "style": "file:./build/index.css",
  "attributes": {
    "heading": {
      "type": "string",
      "default": "Our Features"
    },
    "description": {
      "type": "string",
      "default": "Discover what makes us stand out from the rest."
    },
    "cardsPerRow": {
      "type": "number",
      "default": 3
    },
    "alignment": {
      "type": "string",
      "default": "center"
    },
    "gap": {
      "type": "string",
      "default": "2rem"
    },
    "headingAlignment": {
      "type": "string",
      "default": "center"
    }
  },
  "supports": {
    "align": ["wide", "full"],
    "color": {
      "background": true,
      "text": true
    },
    "spacing": {
      "padding": true,
      "margin": true
    }
  }
}
