{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "fse2/hello-blocks",
	"version": "0.1.0",
	"title": "Hello Blocks",
	"category": "text",
	"icon": "smiley",
	"description": "A simple demo block that displays a hello message.",
	"example": {
		"attributes": {
			"message": "Hello from Block!"
		}
	},
	"attributes": {
		"message": {
			"type": "string",
			"default": "Hello from Block!"
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"color": {
			"background": true,
			"text": true
		}
	},
	"textdomain": "fse2",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
