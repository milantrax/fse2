{
    "name": "fse2",
    "version": "0.1.0",
    "scripts": {
        "build:theme-json": "node build/build-theme-json.js",
        "sync": "node build/sync-theme-styles.js",
        "build:theme": "webpack --mode production",
        "build:blocks": "npm run build --workspaces --if-present",
        "build": "npm run build:theme-json && npm run sync && npm run build:theme && npm run build:blocks",
        "dev:theme": "webpack --mode development --watch",
        "dev:blocks": "npm run start --workspaces --if-present",
        "dev": "npm run build:theme-json && npm run sync && npm run dev:theme & npm run dev:blocks"
    },
    "workspaces": [
        "blocks/*"
    ],
    "devDependencies": {
        "@wordpress/babel-preset-default": "^7.0.0",
        "@wordpress/scripts": "^27.0.0",
        "autoprefixer": "^10.4.16",
        "babel-loader": "^9.1.3",
        "css-loader": "^6.8.1",
        "glob": "^10.3.10",
        "mini-css-extract-plugin": "^2.7.6",
        "postcss": "^8.4.32",
        "postcss-loader": "^7.3.3",
        "sass": "^1.69.5",
        "sass-loader": "^13.3.2",
        "sass-mq": "^7.0.0",
        "webpack": "^5.89.0",
        "webpack-cli": "^5.1.4"
    }
}
