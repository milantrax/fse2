{
    "name": "my-fse-theme",
    "version": "1.0.0",
    "scripts": {
        "sync": "node scripts/sync-theme-vars.js",
        "build": "npm run sync && webpack --mode production",
        "dev": "npm run sync && webpack --mode development --watch",
        "build:blocks": "npm run build --workspaces",
        "dev:blocks": "npm run dev --workspaces"
    },
    "workspaces": [
        "blocks/*"
    ],
    "devDependencies": {
        "@wordpress/babel-preset-default": "^7.0.0",
        "@wordpress/scripts": "^27.0.0",
        "autoprefixer": "^10.4.16",
        "babel-loader": "^9.1.3",
        "css-loader": "^6.8.1",
        "glob": "^10.3.10",
        "mini-css-extract-plugin": "^2.7.6",
        "postcss": "^8.4.32",
        "postcss-loader": "^7.3.3",
        "sass": "^1.69.5",
        "sass-loader": "^13.3.2",
        "sass-mq": "^7.0.0",
        "webpack": "^5.89.0",
        "webpack-cli": "^5.1.4"
    }
}
